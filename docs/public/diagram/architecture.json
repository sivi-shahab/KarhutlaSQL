  "cards": [
    {
      "dot": "rose",
      "title": "Governance in the server",
      "items": [
        "Default-deny per-table privileges (policy YAML)",
        "Tag-based column masking & RLS via AST rewrite",
        "MCP channel always capped by the ai_sandbox profile"
      ]
    },
    {
      "dot": "emerald",
      "title": "Execution",
      "items": [
        "Results streamed as Arrow chunks (64 MB buffer)",
        "Per-identity result cache, snapshot invalidation",
        "Per-team quotas + chargeback"
      ]
    },
    {
      "dot": "amber",
      "title": "Compliance",
      "items": [
        "Per-column PII access history (WORM Parquet)",
        "Signed report runs + DuckLake time travel",
        "Session kills propagated to every instance via the archive"
      ]
    },
    {
      "dot": "cyan",
      "title": "Runtime stack (Go, open source)",
      "items": [
        "Apache Arrow arrow-go v18 — Arrow, Flight SQL, Parquet",
        "DuckDB 1.5.6 via duckdb-go (CGO, static)",
        "grpc-go + protobuf · otelgrpc",
        "pg_query_go (PostgreSQL parser) for authz & rewrite",
        "go-oidc · golang-jwt · x/oauth2 · bcrypt",
        "Prometheus client_golang · OpenTelemetry SDK",
        "minio-go · MCP go-sdk · cobra · viper · yaml.v3"
      ]
    },
    {
      "dot": "violet",
      "title": "Infrastructure & integrations",
      "items": [
        "Keycloak (OIDC IdP) · HashiCorp Vault Transit",
        "PostgreSQL 17 + MinIO for DuckLake",
        "DuckDB extensions: ducklake · postgres_scanner · httpfs",
        "Prometheus + Grafana · OTLP collector",
        "Apache Airflow + Great Expectations 1.x",
        "Unity Catalog OSS (metadata catalog)"
      ]
    },
    {
      "dot": "slate",
      "title": "Build, deploy & test",
      "items": [
        "Docker distroless · Docker Compose · Helm · kind",
        "goreleaser · golangci-lint · govulncheck · syft (SBOM)",
        "pytest · adbc-driver-flightsql · pyarrow",
        "Arrow Flight SQL JDBC driver (smoke test)",
